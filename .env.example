# =============================================================================
# DevPilot Environment Configuration
# =============================================================================

# Application Server
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Google Gemini AI Configuration
# Optional: If omitted or empty, DevPilot automatically activates its deterministic
# mock replay provider for 100% offline testing, demo runs, and test suites.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Security Boundaries & Allowlisted Commands
COMMAND_TIMEOUT_SECONDS=20
MAX_FILE_READ_BYTES=500000

# Persistence
DATABASE_PATH=devpilot.sqlite3
