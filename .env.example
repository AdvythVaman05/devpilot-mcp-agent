# =============================================================================
# DevPilot Environment Configuration
# =============================================================================

# Application Server
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Provider Configuration
# Modes: "demo" (default: deterministic replay + genuine MCP tools) or "live" (requires GEMINI_API_KEY)
PROVIDER_MODE=demo
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash


# Security Boundaries & Allowlisted Commands
COMMAND_TIMEOUT_SECONDS=20
MAX_FILE_READ_BYTES=500000

# Persistence
DATABASE_PATH=devpilot.sqlite3
